{
  "info": {
    "name": "swiftpay — интеграция (PayBridge)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://sandbox.swiftpay.example/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "provider_operation_id",
      "value": "op_test"
    }
  ],
  "item": [
    {
      "name": "Создание операции",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/payments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "payments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Статус операции",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/payments/{{provider_operation_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "payments",
            "{{provider_operation_id}}"
          ]
        }
      }
    }
  ]
}
