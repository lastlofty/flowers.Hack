# frozen_string_literal: true

require 'openssl'
require 'json'
<% if needs_base64? -%>
require 'base64'
<% end -%>

# ────────────────────────────────────────────────────────────────────────
# СГЕНЕРИРОВАНО PayBridge из <%= File.basename(spec_source) %>
# Провайдер: <%= spec.provider_name %> (<%= spec.title %> v<%= spec.version %>)
# Не редактировать вручную — изменения перезапишутся при регенерации.
# ────────────────────────────────────────────────────────────────────────
module Provider
  class <%= spec.provider_class %> < BaseService
    BASE_URL = ENV.fetch('<%= spec.base_url_env %>', '<%= spec.base_url %>')
<% if min_amount -%>
    MIN_AMOUNT = <%= min_amount %>
<% end -%>

<%= render_status_map %>

<%= render_error_map %>

<%= render_symbol_map %>

    def check_conditions(operation, request_method)
      base_result = super
      return base_result if base_result.failed?
<% if min_amount -%>
      return failure(:unprocessable_entity, 'amount_too_low') if operation.amount < MIN_AMOUNT
<% end -%>
      success
    end

    def create_request(operation, request_method = 'create')
      payload  = build_request_payload(operation)
      response = client.post(
        "#{BASE_URL}<%= spec.create_endpoint.path %>",
        json: payload,
        headers: <%= create_headers %>
      )
      parse_create_response(operation, response)
    rescue Provider::RateLimitError
      failure(:too_many_requests, 'provider.rate_limit')
    rescue Provider::UnauthorizedError
      failure(:unauthorized, 'provider.invalid_credentials')
    end
<% if spec.status_endpoint -%>

    def fetch_status(operation)
      response = client.get(
        "#{BASE_URL}<%= status_path_ruby %>",
        headers: auth_headers
      )
      return map_error(response) if response.status >= 400

      mapped = map_status(response.body['status'])
      return failure(:unprocessable_entity, 'unknown_status') if mapped.nil?

      success(status: mapped)
    end
<% end -%>
<% if spec.webhook -%>

    def process_callback(payload)
      verify_signature!(payload)

      case payload['event']
<% unless approve_events.empty? -%>
      when <%= approve_events.map { |e| "'#{e}'" }.join(', ') %>
        approve_operation(payload['<%= spec.webhook.id_field %>'], map_status(payload['status']))
<% end -%>
<% unless reject_events.empty? -%>
      when <%= reject_events.map { |e| "'#{e}'" }.join(', ') %>
        reject_operation(payload['<%= spec.webhook.id_field %>'], payload.dig('error', 'code'))
<% end -%>
      else
        failure(:unprocessable_entity, 'unknown_event')
      end
    end
<% end -%>

    private

    def build_request_payload(operation)
      requisite = operation.payout_requisite || {}
      <%= spec.request_payload_ruby %>
    end

    def parse_create_response(_operation, response)
      case response.status
      when <%= create_success_codes %>
        success(
          provider_operation_id: response.body['id'],
          status: map_status(response.body['status'])
        )
      else
        map_error(response)
      end
    end

    def map_status(provider_status)
      STATUS_MAP[provider_status]
    end

    def map_error(response)
      code    = ERROR_MAP[response.status] || 'internal_error'
      message = response.body.is_a?(Hash) ? response.body.dig('error', 'message') : nil
      failure(error_symbol(response.status), code, data: { message: message || 'provider_error' })
    end

    def error_symbol(http_status)
      HTTP_STATUS_SYMBOL.fetch(http_status, :internal_server_error)
    end
<% if spec.auth -%>

    def auth_headers
      { '<%= spec.auth.header_name %>' => <%= spec.auth.header_value_ruby %> }
    end
<% end -%>
<% if spec.idempotency_header -%>

    def idempotency_key(operation)
      operation.idempotency_key || operation.id.to_s
    end
<% end -%>
<% if spec.webhook && spec.webhook.signature_header -%>

    def verify_signature!(payload)
      secret   = provider.credentials.fetch('<%= spec.webhook.callback_secret_field %>')
      # подпись считается по телу БЕЗ служебного поля _signature
      body     = payload.is_a?(Hash) ? payload.reject { |k, _| k == '_signature' } : payload
      raw_body = body.is_a?(String) ? body : JSON.generate(body)
<% if spec.webhook.signature_encoding == 'base64' -%>
      expected = Base64.strict_encode64(OpenSSL::HMAC.digest('<%= spec.webhook.signature_alg %>', secret, raw_body))
<% else -%>
      expected = OpenSSL::HMAC.hexdigest('<%= spec.webhook.signature_alg %>', secret, raw_body)
<% end -%>
      received = payload.is_a?(Hash) ? payload['_signature'] : nil

      return if received && secure_compare(expected, received)

      raise Provider::UnauthorizedError, 'invalid webhook signature'
    end

    def secure_compare(left, right)
      return false unless left.bytesize == right.bytesize

      OpenSSL.fixed_length_secure_compare(left, right)
    rescue StandardError
      false
    end
<% end -%>

    def approve_operation(provider_operation_id, mapped_status)
      success(provider_operation_id: provider_operation_id, status: mapped_status || 'approved')
    end

    def reject_operation(provider_operation_id, error_code)
      failure(:rejected, error_code || 'rejected', data: { provider_operation_id: provider_operation_id })
    end
  end
end
